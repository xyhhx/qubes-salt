{%- set policies = [
  (policy, "+", "@tag:" ~ client_tag, "@default", "allow target=" ~ vault_vm ~ " notify=yes"),
  (policy, "+", "@tag:" ~ client_tag,  "@tag:" ~ server_tag, "allow notify=yes"),
  (policy, "+", "@anyvm", "@default", "ask default_target=" ~ vault_vm),
  (policy, "+", "@anyvm", "@tag:" ~ server_tag, "ask  default_target=" ~ vault_vm)
] -%}

{%- from "utils/macros/generate_policy_file.sls" import generate_policy_file -%}
{%- include "utils/banner.jinja" -%}

{{ generate_policy_file(policies) }}
