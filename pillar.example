---
# set the defaults for qubes created with salts from this repo
qvm_defaults:
  prefs:
    - label: gray

    - memory: 400
    - maxmem: 2000
    - vcpus: 1

    - kernel: "*default*"
    - kernelopts: "*default*"
    - pci-strictreset: true
    - virt-mode: pvh

    - audiovm: "*default*"
    - guivm: "*default*"
    - netvm: "*default*"

    - autostart: false
    - debug: false
    - default-user: user
    - include-in-backups: false
    - internal: false
    - qrexec-timeout: 120

  features:
    - set:
      - menu-items: Alacritty.desktop
      - default-menu-items: Alacritty.desktop

# User global preferences
user_qubes:
  defaults:
    ctap: sys-onlykey
    gpg: sys-onlykey
    netvm: sys-vpn-ivpn
    ssh: sys-onlykey
    sysusb: disp-sys-usb
    whonix: sys-tor-whonix
    browser: "@dispvm:dvm-trivalent"

# User custom preferences. These override the defaults set in various salt states
# for various guest VMs
user_qvms:
  # Common preferences for user qubes
  prefs:
    dirs:
      # Where to store scripts and binaries that this repo will install into
      # qubes
      user_bins: "/opt/qubes-user/bin"
      # Where to store configs for qubes this repo will manage
      user_configs: "/opt/qubes-user/lib"
    # Default theme info
    theme:
      cursor: "Adwaita"
      gtk: "Adwaita"
      icon: "Adwaita"
    # Default font info
    fonts:
      mono: "IBM Plex Mono 10"
      sans: "Liberation Sans 10"
      serif: "Liberation Serif 10"

  appvms:

    sys_net: {}

    sys_vpn_ivpn:
      qvm: {}
      mfw: {}

  dispvms: {}

  templates:

    provides_mirageos_firewall:
      qvm: {}
      mirageos_release: {}
        # version:
        # checksum:

    uses_app_trivalent:
      qvm: {}
      celenity_titanium:
        enable: true
        block_extensions: true
        allow_trustworthy_extensions: true
        unbreak_bitwarden: false
        allow_webusb: false

    uses_app_tuta:
      qvm: {}
      tuta_release: {}
        # version:
        # checksum:

# vim: ft=yaml ts=2 sw=2 sts=2 et :
